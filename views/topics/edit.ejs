<!doctype html><html lang="uk"><head><meta charset="utf-8"><title>Редагування теми</title><link rel="stylesheet" href="/styles.css"></head>
<body><main class="container">
  <%- include("../partials/nav") %>
  <h1>Редагувати тему</h1>
  <section class="card">
    <form method="POST" action="/topics/<%= item._id %>?_method=PUT">
      <label>Назва</label><input name="title" value="<%= item.title %>" required>
      <button type="submit">Оновити</button>
    </form>
  </section>
  <a class="btn secondary" href="/topics">Назад</a>
</main></body></html>
