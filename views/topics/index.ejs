<!doctype html><html lang="uk"><head><meta charset="utf-8"><title>Теми</title><link rel="stylesheet" href="/styles.css"></head>
<body><main class="container">
  <%- include("../partials/nav") %>
  <h1>Теми розсилки</h1>
  <div class="actions">
    <a class="btn" href="/topics/new">Додати</a>
    <a class="btn secondary" href="/newsletters">Листи</a>
    <a class="btn secondary" href="/subscribers">Передплатники</a>
  </div>

  <section class="card">
    <table border="1" cellpadding="8">
      <thead><tr><th>Назва</th><th>Дії</th></tr></thead>
      <tbody>
      <% items.forEach(i => { %>
        <tr>
          <td><%= i.title %></td>
          <td>
            <a href="/topics/<%= i._id %>/edit">Редагувати</a>
            <form style="display:inline" method="POST" action="/topics/<%= i._id %>?_method=DELETE">
              <button type="submit">Видалити</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </section>
</main></body></html>
