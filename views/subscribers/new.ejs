<!doctype html><html lang="uk"><head><meta charset="utf-8"><title>Новий передплатник</title><link rel="stylesheet" href="/styles.css"></head>
<body><main class="container">
  <%- include("../partials/nav") %>
  <h1>Додати передплатника</h1>
  <section class="card">
    <form method="POST" action="/subscribers">
      <label>Ім’я</label><input name="name" required>
      <label>Email</label><input name="email" type="email" required>
      <label>Логін</label><input name="login" required>
      <label>Хеш пароля</label><input name="password_hash" required>
      <button type="submit">Зберегти</button>
    </form>
  </section>
  <a class="btn secondary" href="/subscribers">Назад</a>
</main></body></html>
