<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <title>Погода</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container">
    <h1>Погода у місті: <%= city %></h1>

    <p>Температура: <%= temp %> °C</p>
    <p>Відчувається як: <%= feels %> °C</p>
    <p>Вологість: <%= humidity %> %</p>
    <p>Швидкість вітру: <%= wind %> м/с</p>
    <p>Опис: <%= description %></p>

    <br>
    <a class="btn secondary" href="/weather">← Назад</a>
    <a class="btn secondary" href="/">Меню</a>
    <a class="btn" href="/weather/api/<%= city %>">JSON</a>
  </main>
</body>
</html>
