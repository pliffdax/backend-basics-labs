<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Погода</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <%- include("../partials/nav") %>
      <h1>Додаток “Погода”</h1>
      <p>Оберіть місто зі списку або введіть свою назву.</p>

      <section class="card">
        <h2>Швидкі посилання</h2>
        <ul class="links">
          <li><a href="/weather/city/Kyiv">Київ</a></li>
          <li><a href="/weather/city/London">Лондон</a></li>
          <li><a href="/weather/city/Paris">Париж</a></li>
        </ul>
      </section>

      <section class="card">
        <h2>Пошук міста</h2>
        <form id="cityForm">
          <label for="cityInput">Назва міста</label>
          <input id="cityInput" name="city" placeholder="Наприклад: Lviv" required />
          <button type="submit">Показати погоду</button>
        </form>
      </section>

      <div class="actions">
        <a class="btn secondary" href="/">Назад до меню</a>
      </div>
    </main>

    <script>
      const form = document.getElementById("cityForm");
      const input = document.getElementById("cityInput");

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const city = (input.value || "").trim();
        if (!city) return;
        window.location.href = `/weather/city/${encodeURIComponent(city)}`;
      });
    </script>
  </body>
</html>
