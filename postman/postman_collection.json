    {
      "name": "Topics",
      "item": [
        {
          "name": "Query: topics",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"query { topics { _id title createdAt } }\"}"
            }
          }
        },
        {
          "name": "Mutation: createTopic (save topicId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "const id = json?.data?.createTopic?._id;",
                  "if (id) pm.environment.set('topicId', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation ($title:String!) { createTopic(title:$title){ _id title } }\",\n  \"variables\": {\n    \"title\": \"Акції\"\n  }\n}"
            }
          }
        },
        {
          "name": "Mutation: updateTopic (uses topicId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation ($id:ID!,$title:String!) { updateTopic(id:$id,title:$title){ _id title } }\",\n  \"variables\": {\n    \"id\": \"{{topicId}}\",\n    \"title\": \"Акції та новини\"\n  }\n}"
            }
          }
        },
        {
          "name": "Mutation: deleteTopic (uses topicId)",
